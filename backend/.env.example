NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgresql://sicef_app:CHANGE_ME@localhost:6432/sicef_db?schema=public
DIRECT_DATABASE_URL=postgresql://sicef_owner:CHANGE_ME@localhost:5432/sicef_db?schema=public
KEYCLOAK_ISSUER_URL=https://<KEYCLOAK_HOST>/realms/SOAPAP
KEYCLOAK_JWKS_URL=https://<KEYCLOAK_HOST>/realms/SOAPAP/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=gsts
KEYCLOAK_AUDIENCE=gsts
NFS_BASE_PATH=/mnt/gsts
MAX_EVIDENCIA_TOTAL_BYTES=31457280
SIGNING_SERVICE_URL=https://signing.example
SIGNING_SERVICE_AUTH_TOKEN=CHANGE_ME
SIGNING_SERVICE_TIMEOUT_MS=10000
OUC_API_URL=https://ouc.example
OUC_API_TOKEN=CHANGE_ME
PUBLIC_BASE_URL=https://portal.example
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30
# Claves HMAC del token de verificación por QR. Mínimo 32 bytes cada una.
# Generar con: openssl rand -base64 48
# Para rotar: definir SECRETO_VERIFICADOR_V2 y apuntar VERSION_TOKEN_ACTUAL a v2.
# La v1 se conserva mientras existan constancias vigentes emitidas con ella.
SECRETO_VERIFICADOR_V1=CHANGE_ME
# SECRETO_VERIFICADOR_V2=CHANGE_ME
VERSION_TOKEN_ACTUAL=v1
VERIFICACION_RATE_LIMIT_WINDOW_MS=60000
VERIFICACION_RATE_LIMIT_MAX=10
