// ============================================================
//  SICNAF — Sistema Integrado de Constancias de No Adeudo y Facturación
//  SOAPAP · Esquema físico (Prisma)
//
//  Principio de dos territorios:
//   - Este archivo modela tablas, columnas, enums, relaciones e índices.
//   - Las reglas duras (append-only de bitácora, transiciones de estado,
//     inmutabilidad de catálogos/tarifas, CHECKs, vista de estado efectivo,
//     rol de BD sin UPDATE/DELETE sobre bitácora) viven en la migración SQL
//     complementaria. La base de datos es la fuente de integridad.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================

enum TipoConstancia {
  NO_ADEUDO
  NO_REGISTRO
}

enum Personalidad {
  FISICA
  MORAL
}

enum Representacion {
  TITULAR
  REPRESENTANTE
  APODERADO
}

/// A qué división administrativa pertenece el domicilio de un predio (solo
/// No Registro). Sin catálogo de nombres: la zona de cobertura abarca Puebla
/// y 4 municipios más, sin lista manejable; el nombre va en domicilioPerteneceANombre.
enum PerteneceA {
  JUNTA_AUXILIAR
  MUNICIPIO
}

enum RolPersona {
  TITULAR
  REPRESENTANTE
  APODERADO
  RECEPTOR_FISCAL
}

/// Máquina de estado del trámite (incluye el puente COBRO y el cierre FINALIZADO).
enum EstadoTramite {
  CAPTURA
  EN_VALIDACION
  APROBADO
  RECHAZADO
  EXPIRADO
  COBRO
  FINALIZADO
}

/// Sub-estados del timbrado del CFDI (solo cuando el trámite requiere factura).
enum EstadoFactura {
  PENDIENTE
  TIMBRADO_EN_PROCESO
  TIMBRADO
  TIMBRADO_FALLIDO
  CANCELADO
}

/// Estado de una captura provisional de cobro. Solo el borrador ABIERTO puede
/// editarse o convertirse en un cobro definitivo.
enum EstadoBorradorCobro {
  ABIERTO
  APLICADO
  VENCIDO
  CANCELADO
}

/// Resultado de una solicitud pública de factura antes de crear el CFDI.
enum EstadoSolicitudFactura {
  PENDIENTE_REVISION
  ACEPTADA
  RECHAZADA
}

enum EstadoConservacionArchivo {
  ACTIVO
  RETENIDO
  ELIMINADO_LOGICO
}

enum OrigenBitacora {
  USUARIO
  SISTEMA
  WORKER
  PORTAL
}

enum MetodoValidacion {
  MANUAL
  API
}

enum MomentoValidacion {
  VALIDACION_INICIAL
  REVALIDACION_COBRO
}

enum ResultadoValidacion {
  SIN_ADEUDO
  CON_ADEUDO
}

enum TipoConfirmacion {
  SIN_ADEUDO_OUC
  FIRMAS_LEGIBLES
  FACULTADES_PODER
}

enum EstadoEvidencia {
  CARGADO
  VALIDADO
  RECHAZADO
}

enum MetodoPago {
  PUE
  PPD
}

// ===================== IDENTIDAD =====================

/// Proyección pseudónima de una identidad autenticada por Keycloak. Solo
/// conserva el `sub` externo para resolver FKs y auditoría; nombres, correos,
/// sesiones y roles pertenecen exclusivamente al realm SOAPAP.
model Actor {
  id          String   @id @default(uuid()) @db.Uuid
  keycloakSub String   @unique @map("keycloak_sub")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Relaciones de autoría/auditoría. Se declaran aquí (en vez de dejar los
  // campos como UUID escalar) para que Prisma administre las FKs y no las
  // trate como "drift" borrándolas en cada `migrate dev`.
  tramitesCreados                   Tramite[]               @relation("TramiteCreadoPor")
  evidenciasCreadas                 Evidencia[]             @relation("EvidenciaCreadoPor")
  validacionesRealizadas            ValidacionNoAdeudo[]    @relation("ValidacionValidadoPor")
  confirmacionesRealizadas          ConfirmacionManual[]    @relation("ConfirmacionConfirmadoPor")
  consultasRealizadas               ConsultaConcesionaria[] @relation("ConsultaRealizadaPor")
  cobrosRealizados                  Cobro[]                 @relation("CobroCobradoPor")
  borradoresCobroCreados            BorradorCobro[]         @relation("BorradorCobroCreadoPor")
  borradoresCobroActualizados       BorradorCobro[]         @relation("BorradorCobroActualizadoPor")
  solicitudesFacturaResueltas       SolicitudFactura[]      @relation("SolicitudFacturaResueltaPor")
  configuracionesPlazosActualizadas ConfiguracionPlazos[]   @relation("ConfiguracionPlazosActualizadoPor")
  configuracionesConstanciaActualizadas ConfiguracionConstancia[] @relation("ConfiguracionConstanciaActualizadoPor")
  entradasBitacora                  Bitacora[]              @relation("BitacoraActor")

  @@map("actor")
}

// ===================== PERSONAS =====================

/// Registro de personas (titular, representante, apoderado o receptor fiscal).
model Persona {
  id                String       @id @default(uuid()) @db.Uuid
  tipo              Personalidad
  nombreRazonSocial String       @map("nombre_razon_social")
  rfc               String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tramites TramitePersona[]

  @@map("persona")
}

/// Vincula una persona a un trámite con un rol específico.
model TramitePersona {
  id        String     @id @default(uuid()) @db.Uuid
  tramiteId String     @map("tramite_id") @db.Uuid
  personaId String     @map("persona_id") @db.Uuid
  rol       RolPersona
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tramite Tramite @relation(fields: [tramiteId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id])

  @@unique([tramiteId, personaId, rol])
  @@index([tramiteId])
  @@map("tramite_persona")
}

// ===================== CATÁLOGO DE REQUISITOS (versionado) =====================

/// Versión inmutable del catálogo de requisitos. Cada trámite estampa la
/// versión vigente al momento de capturarse.
model VersionCatalogo {
  id           String    @id @default(uuid()) @db.Uuid
  version      Int       @unique
  publicada    Boolean   @default(false)
  activa       Boolean   @default(false)
  vigenteDesde DateTime? @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta DateTime? @map("vigente_hasta") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  grupos   GrupoRequisito[]
  tramites Tramite[]

  @@map("version_catalogo")
}

/// Grupo de requisitos con su condición de aplicabilidad (NULL = aplica a todos).
/// Lógica Y entre grupos aplicables.
model GrupoRequisito {
  id                   String          @id @default(uuid()) @db.Uuid
  versionCatalogoId    String          @map("version_catalogo_id") @db.Uuid
  clave                String
  nombre               String
  orden                Int             @default(0)
  aplicaTipo           TipoConstancia? @map("aplica_tipo")
  aplicaPersonalidad   Personalidad?   @map("aplica_personalidad")
  aplicaRepresentacion Representacion? @map("aplica_representacion")

  versionCatalogo VersionCatalogo   @relation(fields: [versionCatalogoId], references: [id])
  opciones        OpcionRequisito[]

  @@unique([versionCatalogoId, clave])
  @@index([versionCatalogoId])
  @@map("grupo_requisito")
}

/// Opción dentro de un grupo. Lógica O: basta satisfacer una opción del grupo.
model OpcionRequisito {
  id      String @id @default(uuid()) @db.Uuid
  grupoId String @map("grupo_id") @db.Uuid
  clave   String
  nombre  String
  orden   Int    @default(0)

  grupo      GrupoRequisito    @relation(fields: [grupoId], references: [id])
  documentos OpcionDocumento[]

  @@unique([grupoId, clave])
  @@map("opcion_requisito")
}

/// Documento exigido por una opción. Una opción compuesta requiere varios
/// documentos (todos presentes para satisfacer la opción).
model OpcionDocumento {
  id       String @id @default(uuid()) @db.Uuid
  opcionId String @map("opcion_id") @db.Uuid
  nombre   String
  orden    Int    @default(0)

  opcion     OpcionRequisito @relation(fields: [opcionId], references: [id])
  evidencias Evidencia[]

  @@map("opcion_documento")
}

// ===================== TRÁMITE =====================

model Tramite {
  id                        String         @id @default(uuid()) @db.Uuid
  numeroTramite             Int            @unique @default(autoincrement()) @map("numero_tramite")
  tipoConstancia            TipoConstancia @map("tipo_constancia")
  personalidad              Personalidad
  representacion            Representacion
  nis                       String? // referencia a la cuenta/predio en OUC (solo No Adeudo)
  domicilioCalle            String?        @map("domicilio_calle") // solo No Registro
  domicilioNumero           String?        @map("domicilio_numero") // string, no int: "612-1", "S/N"
  domicilioColonia          String?        @map("domicilio_colonia")
  domicilioPerteneceA       PerteneceA?    @map("domicilio_pertenece_a")
  domicilioPerteneceANombre String?        @map("domicilio_pertenece_a_nombre") // texto libre: junta auxiliar o municipio
  versionCatalogoId         String         @map("version_catalogo_id") @db.Uuid
  estado                    EstadoTramite  @default(CAPTURA)
  plazoPagoHasta            DateTime?      @map("plazo_pago_hasta") @db.Timestamptz(3) // snapshot calculado desde ConfiguracionPlazos al aprobar
  motivoRechazo             String?        @map("motivo_rechazo")
  creadoPorId               String         @map("creado_por_id") @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  versionCatalogo VersionCatalogo         @relation(fields: [versionCatalogoId], references: [id])
  creadoPorActor  Actor                   @relation("TramiteCreadoPor", fields: [creadoPorId], references: [id])
  personas        TramitePersona[]
  evidencias      Evidencia[]
  validaciones    ValidacionNoAdeudo[]
  confirmaciones  ConfirmacionManual[]
  consultas       ConsultaConcesionaria[]
  borradoresCobro BorradorCobro[]
  constancia      Constancia?
  cobro           Cobro?

  @@index([estado])
  @@index([creadoPorId])
  @@index([createdAt])
  @@map("tramite")
}

/// Evidencia documental. El archivo vive en NFS; aquí solo la referencia lógica.
model Evidencia {
  id                String          @id @default(uuid()) @db.Uuid
  tramiteId         String          @map("tramite_id") @db.Uuid
  opcionDocumentoId String          @map("opcion_documento_id") @db.Uuid
  archivoUuid       String          @unique @map("archivo_uuid") @db.Uuid // nombre del archivo en NFS
  nombreOriginal    String          @map("nombre_original")
  hashSha256        String          @map("hash_sha256")
  mimeType          String          @map("mime_type")
  tamanoBytes       Int             @map("tamano_bytes")
  estado            EstadoEvidencia @default(CARGADO)
  creadoPorId       String          @map("creado_por_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tramite         Tramite         @relation(fields: [tramiteId], references: [id])
  opcionDocumento OpcionDocumento @relation(fields: [opcionDocumentoId], references: [id])
  creadoPorActor  Actor           @relation("EvidenciaCreadoPor", fields: [creadoPorId], references: [id])

  @@index([tramiteId])
  @@index([opcionDocumentoId])
  @@map("evidencia")
}

/// Validación de no adeudo. Puede haber dos por trámite: la inicial (EN_VALIDACION)
/// y la revalidación al emitir (COBRO).
model ValidacionNoAdeudo {
  id            String              @id @default(uuid()) @db.Uuid
  tramiteId     String              @map("tramite_id") @db.Uuid
  metodo        MetodoValidacion
  momento       MomentoValidacion
  resultado     ResultadoValidacion
  adeudoMonto   Decimal?            @map("adeudo_monto") @db.Decimal(12, 2)
  referenciaOuc String?             @map("referencia_ouc")
  validadoPorId String?             @map("validado_por_id") @db.Uuid
  validadoAt    DateTime            @default(now()) @map("validado_at") @db.Timestamptz(3)

  tramite          Tramite @relation(fields: [tramiteId], references: [id])
  validadoPorActor Actor?  @relation("ValidacionValidadoPor", fields: [validadoPorId], references: [id])

  @@unique([tramiteId, momento])
  @@map("validacion_no_adeudo")
}

/// Confirmación manual atribuible (firmas legibles, facultades del poder, etc.).
model ConfirmacionManual {
  id              String           @id @default(uuid()) @db.Uuid
  tramiteId       String           @map("tramite_id") @db.Uuid
  tipo            TipoConfirmacion
  observacion     String?
  confirmadoPorId String           @map("confirmado_por_id") @db.Uuid
  confirmadoAt    DateTime         @default(now()) @map("confirmado_at") @db.Timestamptz(3)

  tramite            Tramite @relation(fields: [tramiteId], references: [id])
  confirmadoPorActor Actor   @relation("ConfirmacionConfirmadoPor", fields: [confirmadoPorId], references: [id])

  @@unique([tramiteId, tipo])
  @@map("confirmacion_manual")
}

/// Consulta informal a la concesionaria (Agua de Puebla), registrada como
/// observación estructurada y atribuible. Su existencia alimenta el KPI.
model ConsultaConcesionaria {
  id             String   @id @default(uuid()) @db.Uuid
  tramiteId      String   @map("tramite_id") @db.Uuid
  observacion    String
  realizadaPorId String   @map("realizada_por_id") @db.Uuid
  realizadaAt    DateTime @default(now()) @map("realizada_at") @db.Timestamptz(3)

  tramite           Tramite @relation(fields: [tramiteId], references: [id])
  realizadaPorActor Actor   @relation("ConsultaRealizadaPor", fields: [realizadaPorId], references: [id])

  @@index([tramiteId])
  @@map("consulta_concesionaria")
}

// ===================== TARIFAS (versionadas) =====================

/// Catálogo de tarifas versionado e inmutable. Cada cobro estampa la tarifa usada.
model Tarifa {
  id             String         @id @default(uuid()) @db.Uuid
  tipoConstancia TipoConstancia @map("tipo_constancia")
  concepto       String
  monto          Decimal        @db.Decimal(12, 2)
  version        Int
  publicada      Boolean        @default(false)
  activa         Boolean        @default(false)
  vigenteDesde   DateTime?      @map("vigente_desde") @db.Timestamptz(3)
  vigenteHasta   DateTime?      @map("vigente_hasta") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  cobros          Cobro[]
  borradoresCobro BorradorCobro[]

  @@unique([tipoConstancia, concepto, version])
  @@map("tarifa")
}

// ===================== COBRO Y EMISIÓN =====================

/// Configuración singleton de los plazos operativos. Sólo un token con claim
/// literal `ti` puede crearla o modificarla; los plazos se estampan en cada evento aplicable.
/// El plazo de pago se copia a Tramite y el de factura a SolicitudFactura.
model ConfiguracionPlazos {
  id                        String   @id @default("PLAZOS_OPERATIVOS")
  plazoPagoDias             Int      @default(0) @map("plazo_pago_dias")
  plazoSolicitudFacturaDias Int      @default(0) @map("plazo_solicitud_factura_dias")
  activa                    Boolean  @default(false)
  actualizadoPorId          String   @map("actualizado_por_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actualizadoPorActor Actor @relation("ConfiguracionPlazosActualizadoPor", fields: [actualizadoPorId], references: [id])

  @@map("configuracion_plazos")
}

/// Parámetros con los que el backend genera el PDF de la constancia: vigencia y
/// datos del firmante. A diferencia de ConfiguracionPlazos (singleton), aquí hay
/// una fila por tipo de constancia, porque el plazo legal puede diferir entre
/// ellos. Nace vacía a propósito: sin configuración no se emite (la vigencia de
/// un documento oficial no debe caer a un valor por defecto que nadie decidió).
model ConfiguracionConstancia {
  tipoConstancia   TipoConstancia @id @map("tipo_constancia")
  vigenciaDias     Int            @map("vigencia_dias")
  firmanteNombre   String         @map("firmante_nombre")
  firmanteCargo    String         @map("firmante_cargo")
  /// Se compone con el año de emisión como "{oficioPrefijo}/{año}", sin
  /// consecutivo. El identificador único del documento sigue siendo el folio.
  oficioPrefijo    String         @map("oficio_prefijo")
  actualizadoPorId String         @map("actualizado_por_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  actualizadoPorActor Actor @relation("ConfiguracionConstanciaActualizadoPor", fields: [actualizadoPorId], references: [id])

  @@map("configuracion_constancia")
}

/// Captura provisional de los datos de pago. Permite que cualquier Ventanilla
/// continúe el cobro sin tratar la captura como un pago confirmado.
model BorradorCobro {
  id                        String              @id @default(uuid()) @db.Uuid
  tramiteId                 String              @map("tramite_id") @db.Uuid
  tarifaId                  String?             @map("tarifa_id") @db.Uuid
  montoBase                 Decimal?            @map("monto_base") @db.Decimal(12, 2)
  motivoReduccionId         String?             @map("motivo_reduccion_id") @db.Uuid
  porcentajeReduccion       Decimal?            @map("porcentaje_reduccion") @db.Decimal(5, 2)
  montoFinal                Decimal?            @map("monto_final") @db.Decimal(12, 2)
  formaPago                 String?             @map("forma_pago")
  metodoPago                MetodoPago?         @map("metodo_pago")
  moneda                    String?             @default("MXN")
  requiereFactura           Boolean?            @map("requiere_factura")
  referenciaPago            String?             @map("referencia_pago")
  comprobanteArchivoUuid    String?             @unique @map("comprobante_archivo_uuid") @db.Uuid
  comprobanteNombreOriginal String?             @map("comprobante_nombre_original")
  comprobanteHashSha256     String?             @map("comprobante_hash_sha256")
  comprobanteMimeType       String?             @map("comprobante_mime_type")
  comprobanteTamanoBytes    Int?                @map("comprobante_tamano_bytes")
  estado                    EstadoBorradorCobro @default(ABIERTO)
  creadoPorId               String              @map("creado_por_id") @db.Uuid
  actualizadoPorId          String              @map("actualizado_por_id") @db.Uuid
  cobroId                   String?             @unique @map("cobro_id") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  aplicadoAt                DateTime?           @map("aplicado_at") @db.Timestamptz(3)
  vencidoAt                 DateTime?           @map("vencido_at") @db.Timestamptz(3)
  canceladoAt               DateTime?           @map("cancelado_at") @db.Timestamptz(3)

  tramite             Tramite          @relation(fields: [tramiteId], references: [id])
  tarifa              Tarifa?          @relation(fields: [tarifaId], references: [id])
  motivoReduccion     MotivoReduccion? @relation(fields: [motivoReduccionId], references: [id])
  creadoPorActor      Actor            @relation("BorradorCobroCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoPorActor Actor            @relation("BorradorCobroActualizadoPor", fields: [actualizadoPorId], references: [id])
  cobro               Cobro?           @relation("BorradorCobroAplicado", fields: [cobroId], references: [id])

  @@index([tramiteId, estado])
  @@index([tarifaId])
  @@index([motivoReduccionId])
  @@map("borrador_cobro")
}

/// Cobro del trámite (siempre aplica). Congela el monto base, la reducción y el
/// total. La constancia se emite en este punto.
model Cobro {
  id                        String     @id @default(uuid()) @db.Uuid
  tramiteId                 String     @unique @map("tramite_id") @db.Uuid
  tarifaId                  String     @map("tarifa_id") @db.Uuid
  montoBase                 Decimal    @map("monto_base") @db.Decimal(12, 2)
  motivoReduccionId         String?    @map("motivo_reduccion_id") @db.Uuid
  porcentajeReduccion       Decimal    @default(0) @map("porcentaje_reduccion") @db.Decimal(5, 2)
  montoFinal                Decimal    @map("monto_final") @db.Decimal(12, 2)
  formaPago                 String     @map("forma_pago") // código c_FormaPago del SAT
  metodoPago                MetodoPago @map("metodo_pago")
  moneda                    String     @default("MXN")
  requiereFactura           Boolean    @default(false) @map("requiere_factura")
  referenciaPago            String?    @map("referencia_pago")
  comprobanteArchivoUuid    String?    @unique @map("comprobante_archivo_uuid") @db.Uuid
  comprobanteNombreOriginal String?    @map("comprobante_nombre_original")
  comprobanteHashSha256     String?    @map("comprobante_hash_sha256")
  comprobanteMimeType       String?    @map("comprobante_mime_type")
  comprobanteTamanoBytes    Int?       @map("comprobante_tamano_bytes")
  cobradoPorId              String     @map("cobrado_por_id") @db.Uuid
  cobradoAt                 DateTime   @default(now()) @map("cobrado_at") @db.Timestamptz(3)

  tramite              Tramite               @relation(fields: [tramiteId], references: [id])
  tarifa               Tarifa                @relation(fields: [tarifaId], references: [id])
  motivoReduccion      MotivoReduccion?      @relation(fields: [motivoReduccionId], references: [id])
  cobradoPorActor      Actor                 @relation("CobroCobradoPor", fields: [cobradoPorId], references: [id])
  borradorOrigen       BorradorCobro?        @relation("BorradorCobroAplicado")
  factura              Factura?
  solicitudesFactura   SolicitudFactura[]
  facturaGlobalDetalle FacturaGlobalDetalle?

  @@index([motivoReduccionId])
  @@map("cobro")
}

/// Catálogo simple de motivos de reducción de tarifa (INAPAM, discapacidad,
/// programa social, etc.). El porcentaje se congela en cobro/borrador_cobro al
/// momento de aplicarse, así que editar o desactivar un motivo aquí nunca
/// altera cobros históricos — sólo deja de ofrecerse hacia adelante.
model MotivoReduccion {
  id         String   @id @default(uuid()) @db.Uuid
  clave      String   @unique
  nombre     String
  porcentaje Decimal  @db.Decimal(5, 2)
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cobros     Cobro[]
  borradores BorradorCobro[]

  @@map("motivo_reduccion")
}

/// Constancia emitida. La firma es nula hasta integrar el Servicio de Firma (PKI).
model Constancia {
  id             String   @id @default(uuid()) @db.Uuid
  tramiteId      String   @unique @map("tramite_id") @db.Uuid
  folioUnico     String   @unique @map("folio_unico")
  hashPdf        String   @map("hash_pdf")
  /// SHA-256 sobre los datos estructurados (folio, tipo, titular, fechas), no
  /// sobre los bytes del PDF: el mismo contenido puede renderizarse distinto.
  hashContenido  String   @map("hash_contenido")
  /// Versión de la clave HMAC con la que se generó el token del QR. Permite
  /// rotar claves sin invalidar lo emitido y saber cuándo retirar una versión.
  versionToken   String   @map("version_token")
  archivoUuid    String   @unique @map("archivo_uuid") @db.Uuid
  firmaDigital   String?  @map("firma_digital") // null hasta PKI
  certificadoId  String?  @map("certificado_id")
  emitidaAt      DateTime @default(now()) @map("emitida_at") @db.Timestamptz(3)
  vigenciaInicio DateTime @map("vigencia_inicio") @db.Timestamptz(3)
  vigenciaFin    DateTime @map("vigencia_fin") @db.Timestamptz(3)
  anulada        Boolean  @default(false)

  tramite  Tramite           @relation(fields: [tramiteId], references: [id])
  archivos ArchivoGenerado[]

  @@index([folioUnico])
  @@map("constancia")
}

// ===================== FACTURACIÓN (CFDI 4.0) =====================

/// Factura CFDI. Solo existe si el ciudadano la solicita. El receptor es un
/// snapshot congelado (no se lee de Persona). Vacía en el corte inicial.
model Factura {
  id                String        @id @default(uuid()) @db.Uuid
  cobroId           String        @unique @map("cobro_id") @db.Uuid
  estado            EstadoFactura @default(PENDIENTE)
  receptorRfc       String?       @map("receptor_rfc")
  receptorNombre    String?       @map("receptor_nombre")
  receptorCp        String?       @map("receptor_cp")
  receptorRegimen   String?       @map("receptor_regimen") // código c_RegimenFiscal
  usoCfdi           String?       @map("uso_cfdi") // código c_UsoCFDI
  idempotencyKey    String        @unique @map("idempotency_key")
  uuid              String?       @unique // folio fiscal (UUID del SAT)
  xmlRuta           String?       @map("xml_ruta")
  pdfRuta           String?       @map("pdf_ruta")
  intentos          Int           @default(0)
  ultimoError       String?       @map("ultimo_error")
  timbradaAt        DateTime?     @map("timbrada_at") @db.Timestamptz(3)
  canceladaAt       DateTime?     @map("cancelada_at") @db.Timestamptz(3)
  motivoCancelacion String?       @map("motivo_cancelacion")
  uuidSustituto     String?       @map("uuid_sustituto")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cobro           Cobro             @relation(fields: [cobroId], references: [id])
  solicitudOrigen SolicitudFactura? @relation("FacturaOrigenSolicitud")
  archivos        ArchivoGenerado[]

  @@index([estado])
  @@map("factura")
}

/// Datos fiscales enviados desde el portal para que Finanzas determine si
/// procede una factura individual. No es una factura ni modifica el cobro.
model SolicitudFactura {
  id              String                 @id @default(uuid()) @db.Uuid
  cobroId         String                 @map("cobro_id") @db.Uuid
  facturaId       String?                @unique @map("factura_id") @db.Uuid
  estado          EstadoSolicitudFactura @default(PENDIENTE_REVISION)
  receptorRfc     String                 @map("receptor_rfc")
  receptorNombre  String                 @map("receptor_nombre")
  receptorCp      String                 @map("receptor_cp")
  receptorRegimen String                 @map("receptor_regimen")
  usoCfdi         String                 @map("uso_cfdi")
  fechaLimite     DateTime               @map("fecha_limite") @db.Timestamptz(3)
  solicitadaAt    DateTime               @default(now()) @map("solicitada_at") @db.Timestamptz(3)
  resueltaPorId   String?                @map("resuelta_por_id") @db.Uuid
  resueltaAt      DateTime?              @map("resuelta_at") @db.Timestamptz(3)
  motivoRechazo   String?                @map("motivo_rechazo")

  cobro            Cobro    @relation(fields: [cobroId], references: [id])
  factura          Factura? @relation("FacturaOrigenSolicitud", fields: [facturaId], references: [id])
  resueltaPorActor Actor?   @relation("SolicitudFacturaResueltaPor", fields: [resueltaPorId], references: [id])

  @@index([cobroId, estado])
  @@index([estado, solicitadaAt])
  @@map("solicitud_factura")
}

// ===================== BITÁCORA (append-only) =====================

/// Registro autoritativo de auditoría. Es de solo anexado: la migración SQL
/// instala un trigger que aborta UPDATE/DELETE y revoca esos privilegios al rol
/// de la aplicación. Para acciones internas conserva actor UUID y el snapshot
/// literal de claims de rol emitidos por Keycloak.
model FacturaGlobal {
  id                String        @id @default(uuid()) @db.Uuid
  periodoInicio     DateTime      @map("periodo_inicio") @db.Timestamptz(3)
  periodoFin        DateTime      @map("periodo_fin") @db.Timestamptz(3)
  receptorRfc       String        @map("receptor_rfc")
  receptorNombre    String        @map("receptor_nombre")
  estado            EstadoFactura @default(PENDIENTE)
  idempotencyKey    String        @unique @map("idempotency_key")
  uuid              String?       @unique
  timbradaAt        DateTime?     @map("timbrada_at") @db.Timestamptz(3)
  canceladaAt       DateTime?     @map("cancelada_at") @db.Timestamptz(3)
  motivoCancelacion String?       @map("motivo_cancelacion")
  uuidSustituto     String?       @map("uuid_sustituto")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  detalles FacturaGlobalDetalle[]
  archivos ArchivoGenerado[]

  @@index([estado])
  @@index([periodoInicio, periodoFin])
  @@map("factura_global")
}

model FacturaGlobalDetalle {
  id              String   @id @default(uuid()) @db.Uuid
  facturaGlobalId String   @map("factura_global_id") @db.Uuid
  cobroId         String   @unique @map("cobro_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  facturaGlobal FacturaGlobal @relation(fields: [facturaGlobalId], references: [id])
  cobro         Cobro         @relation(fields: [cobroId], references: [id])

  @@index([facturaGlobalId])
  @@map("factura_global_detalle")
}

model ArchivoGenerado {
  id              String                    @id @default(uuid()) @db.Uuid
  constanciaId    String?                   @map("constancia_id") @db.Uuid
  facturaId       String?                   @map("factura_id") @db.Uuid
  facturaGlobalId String?                   @map("factura_global_id") @db.Uuid
  tipo            String
  archivoUuid     String                    @unique @map("archivo_uuid") @db.Uuid
  ruta            String
  hashSha256      String                    @map("hash_sha256")
  mimeType        String                    @map("mime_type")
  tamanoBytes     Int                       @map("tamano_bytes")
  conservacion    EstadoConservacionArchivo @default(ACTIVO)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  constancia    Constancia?    @relation(fields: [constanciaId], references: [id])
  factura       Factura?       @relation(fields: [facturaId], references: [id])
  facturaGlobal FacturaGlobal? @relation(fields: [facturaGlobalId], references: [id])

  @@index([constanciaId])
  @@index([facturaId])
  @@index([facturaGlobalId])
  @@map("archivo_generado")
}

model Bitacora {
  id             String         @id @default(uuid()) @db.Uuid
  timestamp      DateTime       @default(now()) @db.Timestamptz(3)
  actorId        String?        @map("actor_id") @db.Uuid // null si origen = SISTEMA/WORKER/PORTAL
  rolesSnapshot  Json?          @map("roles_snapshot")
  ipAddress      String?        @map("ip_address") @db.Inet
  userAgent      String?        @map("user_agent")
  origen         OrigenBitacora
  entidad        String // 'tramite', 'factura', 'constancia'...
  entidadId      String         @map("entidad_id") @db.Uuid
  accion         String // 'TRANSICION_ESTADO', 'VALIDACION_MANUAL'...
  estadoAnterior String?        @map("estado_anterior")
  estadoNuevo    String?        @map("estado_nuevo")
  datosAntes     Json?          @map("datos_antes")
  datosDespues   Json?          @map("datos_despues")
  requestId      String?        @map("request_id") @db.Uuid // el job_id queda reservado para el worker de una fase posterior
  jobId          String?        @map("job_id")
  correccionDeId String?        @map("correccion_de_id") @db.Uuid
  detalle        Json?

  actor        Actor?     @relation("BitacoraActor", fields: [actorId], references: [id])
  correccionDe Bitacora?  @relation("BitacoraCorreccion", fields: [correccionDeId], references: [id])
  correcciones Bitacora[] @relation("BitacoraCorreccion")

  @@index([entidad, entidadId])
  @@index([requestId])
  @@index([timestamp])
  @@index([correccionDeId])
  @@map("bitacora")
}
