# Copia este archivo a .env — Vite sólo expone variables con prefijo VITE_.
VITE_API_BASE_URL=/api/v1
VITE_KEYCLOAK_AUTHORITY=https://<KEYCLOAK_HOST>/realms/SOAPAP
VITE_KEYCLOAK_CLIENT_ID=gsts
# GAF (sistema de Finanzas): en dev, /api/gaf pasa por el proxy de vite.config.ts
# hacia su backend en :3001, sin CORS. En producción son hosts distintos: usa la
# URL absoluta de GAF (ahí sí aplica CORS del lado de GAF).
VITE_GAF_BASE_URL=/api/gaf
